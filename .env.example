# EXP-A, EXP-B, EXP-C, and EXP-E need no credentials. EXP-D (the hosted
# canary) needs the provider variables below. Copy this file to .env and fill
# it in locally; .env is ignored by git and never committed. The experiment
# code reads these from the process environment only, never from a file it
# opens itself, and the CLI never constructs a provider client (epicormic
# decision D10): construction happens in src/epicormic_lab/providers.py.

# Local control of decision D11: the OpenAI-compatible endpoint of the pinned
# llama-server (see experiments/exp_a_calibration/PREREGISTRATION.md for the
# exact model blob and server build).
EPICORMIC_LAB_CONTROL_BASE_URL=http://127.0.0.1:8080/v1

# EXP-D, OpenAI Responses API
OPENAI_API_KEY=

# EXP-D, Anthropic Messages API
ANTHROPIC_API_KEY=

# EXP-D, Amazon Bedrock Converse; the AWS SDK reads its usual credential
# chain, so a named profile is enough.
AWS_PROFILE=
AWS_REGION=

# EXP-D, LiteLLM route: whichever variables the chosen route requires, for
# example VERTEXAI_PROJECT or AZURE_API_KEY. The route is pinned in the EXP-D
# pre-registration.
